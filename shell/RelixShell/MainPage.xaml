<Page
    x:Class="RelixShell.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="#FFDDEBF7"
    IsTabStop="True"
    UseSystemFocusVisuals="False"
    Loaded="OnLoaded">

    <!--
        El foco se queda en la página, nunca en el WebView2: así la consola no
        muestra el cursor del "modo mouse" ni le entrega el control a la web.
        El control lo lee GamepadInput y se lo pasa a la interfaz por mensajes.
    -->
    <Grid>
        <muxc:WebView2
            x:Name="Web"
            IsTabStop="False"
            RequiresPointer="Never"
            GotFocus="OnWebGotFocus" />
    </Grid>
</Page>
