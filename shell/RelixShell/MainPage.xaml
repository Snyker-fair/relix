<Page
    x:Class="RelixShell.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="#FFDDEBF7"
    IsTabStop="True"
    UseSystemFocusVisuals="False"
    Loaded="OnLoaded">

    <!--
        The focus stays on the page, never on the WebView2: that way the console
        doesn't show the "mouse mode" cursor or hand the controller to the web page.
        GamepadInput reads the controller and passes it to the interface as messages.
    -->
    <Grid>
        <muxc:WebView2
            x:Name="Web"
            IsTabStop="False"
            RequiresPointer="Never"
            GotFocus="OnWebGotFocus" />
    </Grid>
</Page>
