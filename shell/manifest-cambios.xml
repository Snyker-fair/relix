<!--
  Cambios en Package.appxmanifest de RelixShell.
  Lo más fácil es hacerlos con el diseñador (doble clic en Package.appxmanifest),
  como explica shell/README.md. Esto es lo que debe quedar en el XML.
-->

<!-- 1. Dentro de <Application ...>, después de <uap:VisualElements .../> -->
<Extensions>
  <uap:Extension Category="windows.protocol">
    <uap:Protocol Name="relix">
      <uap:DisplayName>Relix</uap:DisplayName>
    </uap:Protocol>
  </uap:Extension>
</Extensions>

<!-- 2. Reemplaza el bloque <Capabilities> completo -->
<Capabilities>
  <Capability Name="internetClient" />
  <uap:Capability Name="removableStorage" />
</Capabilities>

<!-- 2b. Nombre del autor, dentro de <Properties>. Solo se muestra:
     no cambia la identidad del paquete ni obliga a reinstalar. -->
<Properties>
  <DisplayName>Relix</DisplayName>
  <PublisherDisplayName>snyker-fair</PublisherDisplayName>
  <Logo>Assets\StoreLogo.png</Logo>
</Properties>

<!-- 3. Colores en <uap:VisualElements> y <uap:SplashScreen> -->
<uap:VisualElements
  DisplayName="Relix"
  Description="Tus reliquias, listas para jugar."
  BackgroundColor="#DDEBF7"
  Square150x150Logo="Assets\Square150x150Logo.png"
  Square44x44Logo="Assets\Square44x44Logo.png">
  <!-- Square310x310Logo: tile grande (gema y nombre), nítido en TV 4K.
       Sin ShowNameOnTiles: el nombre ya viene dibujado en las imágenes. -->
  <uap:DefaultTile
    Wide310x150Logo="Assets\Wide310x150Logo.png"
    Square310x310Logo="Assets\Square310x310Logo.png" />
  <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#DDEBF7" />
</uap:VisualElements>
